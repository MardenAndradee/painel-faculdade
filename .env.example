# =============================================================================
# Variaveis usadas pelo docker-compose na raiz.
# As aplicacoes tem seus proprios .env (apps/api/.env e apps/web/.env.local).
# =============================================================================

POSTGRES_USER=painel
POSTGRES_PASSWORD=painel_dev_password
POSTGRES_DB=painel_faculdade

# Porta exposta no host. 5433 evita conflito com um PostgreSQL ja instalado na 5432.
POSTGRES_PORT=5433

API_PORT=3333
WEB_PORT=3000
