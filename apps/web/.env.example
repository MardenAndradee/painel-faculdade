# =============================================================================
# Web - copie para apps/web/.env.local
# =============================================================================

# URL publica da API consumida pelo browser.
NEXT_PUBLIC_API_URL="http://localhost:3333/api/v1"

# Nome exibido na interface.
NEXT_PUBLIC_APP_NAME="Painel Faculdade"

# Chave publica VAPID (Push Notifications, Etapa 28.11) - mesmo par gerado
# em apps/api com npx web-push generate-vapid-keys. So a metade publica.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
