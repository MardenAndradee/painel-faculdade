# =============================================================================
# API - copie para apps/api/.env e preencha os valores
# =============================================================================

NODE_ENV=development
PORT=3333

# -----------------------------------------------------------------------------
# Banco de dados
# -----------------------------------------------------------------------------
# Postgres instalado localmente (porta 5432):
DATABASE_URL="postgresql://painel:painel_dev_password@localhost:5432/painel_faculdade?schema=public"
# Postgres via docker compose (porta 5433 no host):
# DATABASE_URL="postgresql://painel:painel_dev_password@localhost:5433/painel_faculdade?schema=public"

# Neon (producao): DATABASE_URL leva a connection string *pooled* (sufixo
# "-pooler" no host) - e a que a aplicacao usa em runtime. DIRECT_DATABASE_URL
# e opcional e leva a direta (sem pooler); quando definida, `prisma migrate`
# usa ela em vez de DATABASE_URL, porque o pooler em modo transacao nao
# suporta os comandos DDL que uma migration precisa emitir.
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.sa-east-1.aws.neon.tech/painel_faculdade?sslmode=require"
# DIRECT_DATABASE_URL="postgresql://user:pass@ep-xxx.sa-east-1.aws.neon.tech/painel_faculdade?sslmode=require"

# -----------------------------------------------------------------------------
# JWT - gere segredos distintos com: openssl rand -base64 48
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET="troque-por-um-segredo-longo-e-aleatorio"
JWT_REFRESH_SECRET="troque-por-outro-segredo-longo-e-aleatorio"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Google OAuth2 - https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3333/api/v1/auth/google/callback"

# -----------------------------------------------------------------------------
# Frontend / CORS
# -----------------------------------------------------------------------------
WEB_APP_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# -----------------------------------------------------------------------------
# Rate limit (janela em ms e maximo de requisicoes por janela)
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# -----------------------------------------------------------------------------
# Upload de materiais
# -----------------------------------------------------------------------------
# "local" grava em UPLOAD_DIR (dev, Docker com volume). Use "r2" em producao
# serverless (Vercel), onde nao ha disco persistente entre invocacoes.
STORAGE_DRIVER=local
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=25

# Cloudflare R2 - obrigatorias apenas quando STORAGE_DRIVER=r2.
# Painel do bucket -> Manage API tokens -> Create API token (permissao Object Read & Write).
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME="painel-faculdade-materiais"

LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Push Notifications - gere o par com: npx web-push generate-vapid-keys
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@painelfaculdade.app"
# Segredo compartilhado com o Vercel Cron que dispara /push/dispatch - gere com: openssl rand -base64 32
CRON_SECRET=""
