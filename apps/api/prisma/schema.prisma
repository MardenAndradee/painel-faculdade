// =============================================================================
// Painel Faculdade - schema do banco de dados
// =============================================================================
// Convencoes adotadas:
//
// - Toda entidade pertencente a um usuario carrega `userId` com onDelete: Cascade.
//   Isso permite filtrar por dono em uma unica clausula e garante que a exclusao
//   da conta remova todos os dados derivados.
// - Notas e pesos usam Float. Decimal seria necessario para valores monetarios,
//   mas notas academicas tem precisao baixa (0-10 com ate 2 casas) e Decimal
//   obrigaria conversao manual em toda resposta JSON da API.
// - Identificadores externos do Google sao unicos por usuario, nunca globalmente:
//   duas contas podem legitimamente importar a mesma turma do Classroom.
// =============================================================================

// Generator do Prisma 7: emite ESM nativo (o antigo `prisma-client-js` era
// CommonJS e quebrava o import nomeado neste projeto, que e ESM puro).
// O codigo gerado fica dentro de src/ para ser resolvido pelo tsconfig.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  /// Emite os imports internos com extensao `.js`.
  ///
  /// Sem isto o client gerado usa `import ... from './internal/class'`, sem
  /// extensao. O `tsx` do desenvolvimento resolve assim mesmo, mas o Node em
  /// ESM puro exige a extensao explicita - e `node dist/server.js` morria com
  /// ERR_MODULE_NOT_FOUND no primeiro boot de producao.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Enums
// =============================================================================

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum SemesterStatus {
  PLANNED
  ACTIVE
  FINISHED
}

enum SubjectStatus {
  IN_PROGRESS
  APPROVED
  FAILED
  WITHDRAWN
}

/// Discriminador da origem da atividade. Atividades manuais e importadas do
/// Classroom compartilham a mesma tabela porque aparecem nas mesmas listas,
/// filtros, calendario e estatisticas - separa-las exigiria UNION em toda query.
enum AssignmentSource {
  MANUAL
  GOOGLE_CLASSROOM
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CalendarEventSource {
  MANUAL
  GOOGLE_CALENDAR
}

enum AttachmentType {
  PDF
  IMAGE
  ZIP
  SLIDE
  LINK
  DOCUMENT
  OTHER
}

enum AttachmentSource {
  UPLOAD
  LINK
  GOOGLE_CLASSROOM
  GOOGLE_DRIVE
}

enum StudySessionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum NotificationType {
  ASSIGNMENT_DUE
  ASSIGNMENT_OVERDUE
  ASSIGNMENT_CREATED
  EXAM_UPCOMING
  GRADE_POSTED
  STUDY_SESSION
  SYNC_COMPLETED
  SYNC_FAILED
  SYSTEM
  /// Aviso publicado no mural de uma turma (Etapa 22).
  CLASS_ANNOUNCEMENT
}

/// Urgencia da notificacao, separada do tipo: a mesma atividade vira
/// ATTENTION quando vence amanha e URGENT quando vence hoje, sem trocar de
/// tipo. Mapeia as variantes de Badge que ja existem na interface.
enum NotificationPriority {
  URGENT
  ATTENTION
  INFO
  DONE
}

/// Papel do membro numa turma (Etapa 20). Sem MODERATOR por enquanto - so
/// entra se algum dono real pedir delegacao, que nao e o caso hoje.
enum ClassRole {
  OWNER
  MEMBER
}

/// LEFT preserva o historico do vinculo (quando entrou, quando saiu) em vez de
/// apagar a linha - sair e voltar não deveria parecer uma entrada nova.
enum ClassMemberStatus {
  ACTIVE
  LEFT
}

/// O que um `ClassPost` publica (Etapa 21). Cada turma vira exatamente uma
/// entidade pessoal por membro: Assignment, Exam ou CalendarEvent.
enum ClassPostKind {
  ASSIGNMENT
  EXAM
  EVENT
}

/// Modulos configuraveis pelo usuario (Etapa 29) - cada valor mapeia 1:1 pra
/// uma tela da experiencia principal. Desativar um modulo nunca apaga dado
/// nenhum, so tira da Sidebar/Dashboard/busca/notificacoes. Integracoes fica
/// de fora: dobrou para dentro de Configuracoes, sem toggle proprio. Ver
/// docs/planning/modulos-configuraveis.md.
enum AppModule {
  SUBJECTS
  ASSIGNMENTS
  EXAMS
  CALENDAR
  GRADES
  HISTORY
  MATERIALS
  FLASHCARDS
  STUDY_PLAN
  EXAM_PREP
  STATISTICS
  CLASSES
}

// =============================================================================
// Usuario e autenticacao
// =============================================================================

/// Provedor de uma AuthIdentity (autenticacao e-mail+senha, Etapa 26). So
/// GOOGLE por enquanto - a tabela ja nasce pronta para um segundo provedor
/// (Microsoft/Apple) sem migracao nova.
enum AuthProvider {
  GOOGLE
}

/// Motivo de um EmailToken (Etapa 26): confirmar o e-mail no cadastro por
/// senha, ou autorizar a troca de uma senha esquecida.
enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model User {
  id        String  @id @default(cuid())
  email     String  @unique
  name      String
  avatarUrl String?

  /// DEPRECADO desde a Etapa 26 (autenticacao e-mail+senha) - a identidade do
  /// Google mora em `AuthIdentity` a partir dai. Mantido sem leitura, sem
  /// prazo definido de remocao, como rede de seguranca barata contra bug de
  /// migracao. Nunca mais escrito.
  googleId String? @unique

  /// Hash argon2id da senha. Nulo para quem so usa Google.
  passwordHash      String?
  /// Nulo = e-mail nunca confirmado. Setado automaticamente no cadastro via
  /// Google (o Google ja verifica) e manualmente no fluxo de verificacao do
  /// cadastro por senha. So contas verificadas entram no auto-link do Google
  /// (ver `passwordClaimedAt` e docs/modules/autenticacao.md, risco R1).
  emailVerifiedAt   DateTime?
  /// Setado no PRIMEIRO login por senha bem-sucedido, nunca mais tocado.
  /// Distingue "a pessoa ja provou que sabe a senha" de "so o e-mail foi
  /// confirmado" - fecha o risco de sequestro por ocupacao de e-mail
  /// (pre-hijacking, R1): se o Google linkar numa conta cujo e-mail foi
  /// verificado mas cuja senha nunca foi usada pra entrar, a senha e
  /// invalidada no ato do link.
  passwordClaimedAt DateTime?

  /// Tentativas de senha erradas consecutivas. Zerado em qualquer login por
  /// senha bem-sucedido. Base do limite POR CONTA (R2) - o rate limit por IP
  /// (`express-rate-limit`) sozinho nao pega forca bruta distribuida entre
  /// varias origens contra a mesma conta.
  failedLoginAttempts Int       @default(0)
  /// Login por senha bloqueado ate este instante, apos exceder o limite de
  /// tentativas. Nulo = sem bloqueio ativo. Nao afeta login por Google.
  lockedUntil         DateTime?

  theme    ThemePreference @default(SYSTEM)
  timezone String          @default("America/Sao_Paulo")
  locale   String          @default("pt-BR")

  /// Tokens do Google guardados para sincronizar Classroom e Calendar sem
  /// exigir novo consentimento a cada acesso. Credencial de INTEGRACAO, nao
  /// de identidade - por isso continuam aqui mesmo apos a Etapa 26 mover a
  /// identidade do Google para `AuthIdentity`.
  googleAccessToken  String?   @db.Text
  googleRefreshToken String?   @db.Text
  googleTokenExpiry  DateTime?

  /// Escopos ja concedidos pelo usuario. Sem isso nao ha como saber se a
  /// permissao do Classroom foi autorizada sem chamar a API e receber 403.
  googleGrantedScopes String[]  @default([])
  classroomSyncedAt   DateTime?
  calendarSyncedAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastLogin DateTime?

  refreshTokens       RefreshToken[]
  authIdentities      AuthIdentity[]
  emailTokens         EmailToken[]
  semesters           Semester[]
  teachers            Teacher[]
  subjects            Subject[]
  assignments         Assignment[]
  exams               Exam[]
  grades              Grade[]
  gradeConfigurations GradeConfiguration[]
  gradeComponents     GradeComponent[]

  /// Modelo padrao pessoal do usuario (Etapa 19): pre-preenche o modelo de
  /// um semestre novo e disciplinas importadas do Classroom quando o
  /// semestre ainda nao tem modelo proprio. Criado automaticamente no
  /// primeiro login (N1/N2/N3), editavel depois como qualquer outro modelo.
  defaultGradeConfiguration GradeConfiguration? @relation("UserDefaultGradeConfiguration")
  calendarEvents            CalendarEvent[]
  attachments               Attachment[]
  studySessions             StudySession[]
  notifications             Notification[]
  decks                     Deck[]
  flashcards                Flashcard[]
  flashcardReviews          FlashcardReview[]
  studyAvailability         StudyAvailability[]
  noteFolders               NoteFolder[]
  notes                     Note[]

  /// Turmas das quais e dono (Etapa 20).
  ownedClasses      Class[]            @relation("ClassOwner")
  classMemberships  ClassMember[]
  createdInvites    ClassInvite[]
  classSubjectLinks ClassSubjectLink[]
  createdClassPosts ClassPost[]
  classPostCopies   ClassPostCopy[]

  /// Mural da turma (Etapa 22): avisos e anotações que este usuário publicou
  /// como dono. Sem *fan-out* - ver "O que é compartilhado de verdade" no README.
  createdClassAnnouncements ClassAnnouncement[]
  createdClassNotes         ClassNote[]

  /// Materiais da turma que este usuário enviou (Etapa 23) - qualquer membro
  /// publica, não só o dono.
  uploadedClassMaterials ClassMaterial[]
  examPreps              ExamPrep[]
  moduleSettings         UserModuleSetting[]
  pushSubscriptions      PushSubscription[]

  @@index([email])
  @@map("users")
}

// =============================================================================
// Modulos configuraveis (Etapa 29)
// =============================================================================

/// Preferencia de UM usuario para UM modulo. Tabela esparsa de proposito: uma
/// linha so existe quando o usuario desvia do padrao (MODULE_DEFAULT_ENABLED,
/// em packages/shared) - ausencia de linha = padrao. Como o padrao de quase
/// todo modulo ja e "ativado" (unica excecao e FLASHCARDS), nenhuma migracao
/// de backfill foi necessaria para usuarios existentes ao lancar esta etapa.
model UserModuleSetting {
  id        String    @id @default(cuid())
  module    AppModule
  enabled   Boolean
  updatedAt DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@index([userId])
  @@map("user_module_settings")
}

/// Refresh tokens ficam em tabela propria (e nao em coluna do usuario) para
/// permitir varias sessoes simultaneas e revogacao individual por dispositivo.
model RefreshToken {
  id String @id @default(cuid())

  /// Hash SHA-256 do token. O valor puro nunca e persistido.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Identidade de terceiro vinculada a um usuario (Etapa 26 - autenticacao
/// e-mail+senha). So provedores OAuth entram aqui - senha e intrinseca ao
/// `User` (`passwordHash`), nao uma identidade de terceiro.
///
/// A chave e SEMPRE o id de conta do provedor (`providerAccountId` = `sub` do
/// Google), nunca o e-mail: o Google permite trocar o e-mail de uma conta, e
/// usar o e-mail como chave faria o vinculo se perder nessa troca. Mesma
/// regra que ja valia para `User.googleId` antes desta etapa.
model AuthIdentity {
  id                String       @id @default(cuid())
  provider          AuthProvider
  providerAccountId String

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Esta conta do provedor so pode apontar para 1 usuario.
  @@unique([provider, providerAccountId])
  /// 1 usuario so tem 1 vinculo por provedor.
  @@unique([userId, provider])
  @@map("auth_identities")
}

/// Token de uso unico enviado por e-mail (Etapa 26: verificacao de cadastro e
/// recuperacao de senha). Mesmo padrao de `RefreshToken`: so o hash SHA-256 e
/// persistido, o valor puro trafega apenas na URL do e-mail enviado.
model EmailToken {
  id        String            @id @default(cuid())
  purpose   EmailTokenPurpose
  tokenHash String            @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("email_tokens")
}

// =============================================================================
// Estrutura academica
// =============================================================================

model Semester {
  id     String         @id @default(cuid())
  name   String
  year   Int
  /// Periodo dentro do ano: 1 ou 2.
  term   Int
  status SemesterStatus @default(ACTIVE)

  startDate DateTime
  endDate   DateTime

  /// Semestre exibido por padrao no dashboard.
  isCurrent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjects Subject[]

  /// Modelo padrao de notas do semestre: so serve para pre-preencher os
  /// componentes de disciplinas novas (copia, nunca compartilha o registro).
  gradeConfigurationTemplate GradeConfiguration?

  /// Semestres pessoais nascidos de uma entrada em turma (Etapa 20) - um por
  /// membro, nunca compartilhado.
  classMembers ClassMember[]

  @@unique([userId, year, term])
  @@index([userId, isCurrent])
  @@map("semesters")
}

model Teacher {
  id    String  @id @default(cuid())
  name  String
  email String?
  phone String?
  notes String? @db.Text

  /// Identificador do professor no Google Classroom, usado para deduplicar
  /// importacoes repetidas.
  googleUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjects Subject[]

  @@unique([userId, googleUserId])
  @@index([userId])
  @@map("teachers")
}

model Subject {
  id          String  @id @default(cuid())
  name        String
  code        String?
  description String? @db.Text

  /// Cor em hexadecimal (#RRGGBB) usada em cards, calendario e graficos.
  color   String  @default("#6366f1")
  room    String?
  credits Int?

  status SubjectStatus @default(IN_PROGRESS)

  /// Media final consolidada quando o semestre encerra. Enquanto a disciplina
  /// esta em andamento a media e calculada sob demanda a partir de Grade.
  finalGrade Float?

  /// Identificador do curso no Google Classroom.
  googleCourseId String?
  classroomLink  String?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  semesterId String?
  semester   Semester? @relation(fields: [semesterId], references: [id], onDelete: SetNull)

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  assignments    Assignment[]
  exams          Exam[]
  grades         Grade[]
  attachments    Attachment[]
  calendarEvents CalendarEvent[]
  studySessions  StudySession[]
  decks          Deck[]
  noteFolders    NoteFolder[]
  notes          Note[]

  /// Componentes de avaliacao e nota de aprovacao da disciplina. 1-1 e sempre
  /// independente: pode ter sido copiada do modelo padrao do semestre ao criar
  /// a disciplina, mas editar depois nunca afeta o modelo nem outras disciplinas.
  /// Obrigatoria na pratica - garantido pelo service, ver comentario em
  /// GradeConfiguration (Prisma nao expressa 1-1 obrigatorio quando a FK mora
  /// do outro lado da relacao).
  gradeConfiguration GradeConfiguration?

  /// Vinculos com disciplinas de turmas (Etapa 20) - uma disciplina pode ser
  /// alvo de mais de um vinculo (turmas diferentes com a mesma matéria).
  classSubjectLinks ClassSubjectLink[]

  @@unique([userId, googleCourseId])
  @@index([userId, semesterId])
  @@index([userId, status])
  @@map("subjects")
}

// =============================================================================
// Atividades
// =============================================================================

model Assignment {
  id          String  @id @default(cuid())
  title       String
  description String? @db.Text
  notes       String? @db.Text

  dueDate  DateTime?
  priority Priority         @default(MEDIUM)
  status   AssignmentStatus @default(PENDING)
  source   AssignmentSource @default(MANUAL)

  completedAt DateTime?

  /// Pontuacao maxima informada pelo professor, quando existir.
  maxPoints Float?

  // --- Campos exclusivos de atividades importadas do Google Classroom ---
  googleCourseWorkId String?
  /// Estado bruto vindo do Classroom (PUBLISHED, DRAFT, DELETED).
  classroomState     String?
  classroomLink      String?
  /// Ultima vez que esta atividade foi atualizada por uma sincronizacao.
  syncedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId String?
  /// Cascade: excluir a disciplina apaga suas atividades tambem, como a tela
  /// de confirmacao ja promete ao usuario. Atividade sem disciplina (avulsa)
  /// so existe quando criada assim - nunca sobra orfa por causa de uma exclusao.
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  grade          Grade?
  attachments    Attachment[]
  calendarEvents CalendarEvent[]
  studySessions  StudySession[]

  /// Não-nulo = veio de uma publicação de turma (Etapa 21) - selo "Da turma",
  /// mesmo padrão de `source: GOOGLE_CLASSROOM`. SetNull: excluir o post
  /// original não apaga a cópia, só tira o selo (ver `ClassPostCopy`).
  classPostId   String?
  classPost     ClassPost?     @relation(fields: [classPostId], references: [id], onDelete: SetNull)
  classPostCopy ClassPostCopy?

  /// Garante idempotencia da sincronizacao: reimportar o mesmo courseWork
  /// atualiza o registro existente em vez de criar duplicata.
  @@unique([userId, googleCourseWorkId])
  @@index([userId, status, dueDate])
  @@index([userId, dueDate])
  @@index([subjectId])
  @@index([classPostId])
  @@map("assignments")
}

// =============================================================================
// Provas
// =============================================================================

model Exam {
  id      String  @id @default(cuid())
  title   String
  content String? @db.Text
  notes   String? @db.Text
  room    String?

  date            DateTime
  durationMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  /// A que componente de avaliacao esta prova se refere (N1, N2...), quando
  /// a disciplina tem uma configuracao de notas. Opcional: nem toda prova
  /// precisa lancar nota diretamente.
  ///
  /// Tambem define o PESO da prova (Etapa 18): o peso mora no componente e e
  /// derivado na leitura, para que editar o peso do N1 valha para todas as
  /// provas dele em vez de deixar copias desatualizadas por ai.
  gradeComponentId String?
  gradeComponent   GradeComponent? @relation(fields: [gradeComponentId], references: [id], onDelete: SetNull)

  grade          Grade?
  attachments    Attachment[]
  calendarEvents CalendarEvent[]
  studySessions  StudySession[]

  /// Selo "Da turma" (Etapa 21) - ver o comentário equivalente em `Assignment`.
  classPostId   String?
  classPost     ClassPost?     @relation(fields: [classPostId], references: [id], onDelete: SetNull)
  classPostCopy ClassPostCopy?

  /// Plano de Estudos (Etapa 27) - no maximo um por prova, ja que a prova em
  /// si e exclusiva de um aluno (inclusive quando veio de turma, via fan-out).
  examPrep ExamPrep?

  @@index([userId, date])
  @@index([subjectId])
  @@index([gradeComponentId])
  @@index([classPostId])
  @@map("exams")
}

// =============================================================================
// Notas
// =============================================================================

/// Uma nota pode existir sozinha (lancamento avulso) ou vinculada a uma prova
/// ou atividade. A relacao e 1-1 opcional em ambos os lados.
///
/// O sistema nao sabe que existem "N1/N2/N3" - ele sabe que existem
/// componentes de avaliacao configuraveis (GradeComponent). Antes dessa
/// Etapa 17 havia um enum fixo (GradeType: P1/P2/P3/...) aqui, que prendia o
/// calculo ao modelo de uma unica instituicao.
model Grade {
  id    String  @id @default(cuid())
  /// Rotulo livre opcional, util para distinguir varios lancamentos do mesmo
  /// componente ("Lista 3", "Trabalho em grupo").
  label String?

  value    Float
  maxValue Float @default(10)

  /// Falso quando o professor ainda vai somar pontos a este componente (um
  /// trabalho lancado em partes, por exemplo). Enquanto falso, o componente
  /// conta como pendente no calculo da media/nota necessaria - a nota parcial
  /// fica visivel, mas nao "fecha" o componente. Editar a nota mais tarde
  /// para marcar como final e o que consolida o valor na media.
  isFinal Boolean @default(true)

  gradedAt DateTime @default(now())
  notes    String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  /// Substitui o antigo `type`. O peso usado no calculo vem daqui (do
  /// componente), nao e mais digitado a mao em cada nota.
  gradeComponentId String
  gradeComponent   GradeComponent @relation(fields: [gradeComponentId], references: [id], onDelete: Restrict)

  examId String? @unique
  exam   Exam?   @relation(fields: [examId], references: [id], onDelete: SetNull)

  assignmentId String?     @unique
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([userId, subjectId])
  @@index([subjectId, gradeComponentId])
  @@map("grades")
}

/// Configuracao de notas: componentes de avaliacao + nota de aprovacao.
///
/// Sempre pertence a exatamente uma coisa - uma disciplina (`subjectId`, o
/// caso normal, usado de fato no calculo), um semestre (`semesterId`, um
/// modelo padrao que so serve para pre-preencher disciplinas novas) OU o
/// usuario (`defaultForUserId`, o modelo pessoal padrao - Etapa 19). As tres
/// FKs sao independentes (mesmo padrao ja usado em Grade.examId/assignmentId)
/// porque o Prisma nao tem uma forma nativa de expressar "exatamente uma das
/// tres" - a regra e garantida pelo service.
model GradeConfiguration {
  id           String @id @default(cuid())
  passingGrade Float  @default(6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId String?  @unique
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  semesterId String?   @unique
  semester   Semester? @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  /// Setado apenas na linha que e o modelo pessoal padrao do usuario - ver
  /// `User.defaultGradeConfiguration`.
  defaultForUserId String? @unique
  defaultForUser   User?   @relation("UserDefaultGradeConfiguration", fields: [defaultForUserId], references: [id], onDelete: Cascade)

  components GradeComponent[]

  @@index([userId])
  @@map("grade_configurations")
}

/// Um componente de avaliacao configuravel (ex.: "N1", peso 3).
model GradeComponent {
  id     String @id @default(cuid())
  name   String
  weight Float

  /// Ordem de exibicao (N1, N2, N3...). Nao e alfabetica nem por peso.
  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  gradeConfigurationId String
  gradeConfiguration   GradeConfiguration @relation(fields: [gradeConfigurationId], references: [id], onDelete: Cascade)

  /// Restrict em Grade.gradeComponent impede excluir um componente que ainda
  /// tem nota lancada (ver acima) - por isso essa lista importa para o
  /// service validar antes de tentar.
  grades Grade[]
  exams  Exam[]

  @@index([gradeConfigurationId])
  @@map("grade_components")
}

// =============================================================================
// Calendario
// =============================================================================

/// Eventos proprios do calendario: criados manualmente ou importados do Google
/// Calendar. Provas e atividades NAO sao duplicadas aqui - a agenda as agrega
/// em tempo de consulta. As relacoes opcionais abaixo existem apenas para o
/// caso inverso: um evento do Google que o usuario vinculou a uma prova/atividade.
model CalendarEvent {
  id          String  @id @default(cuid())
  title       String
  description String? @db.Text
  location    String?

  startsAt DateTime
  endsAt   DateTime
  allDay   Boolean  @default(false)

  color  String?
  source CalendarEventSource @default(MANUAL)

  // --- Campos exclusivos de eventos importados do Google Calendar ---
  googleEventId    String?
  googleCalendarId String?
  syncedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  examId String?
  exam   Exam?   @relation(fields: [examId], references: [id], onDelete: Cascade)

  /// Selo "Da turma" (Etapa 21) - ver o comentário equivalente em `Assignment`.
  classPostId   String?
  classPost     ClassPost?     @relation(fields: [classPostId], references: [id], onDelete: SetNull)
  classPostCopy ClassPostCopy?

  @@unique([userId, googleEventId])
  @@index([userId, startsAt])
  @@index([classPostId])
  @@map("calendar_events")
}

// =============================================================================
// Materiais
// =============================================================================

model Attachment {
  id   String         @id @default(cuid())
  name String
  type AttachmentType @default(OTHER)

  /// URL publica (link externo) ou caminho servido pela API (upload local).
  url        String  @db.Text
  /// Chave no storage. Nulo quando o anexo e apenas um link.
  storageKey String?

  mimeType  String?
  sizeBytes Int?

  source AttachmentSource @default(UPLOAD)

  googleDriveId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  examId String?
  exam   Exam?   @relation(fields: [examId], references: [id], onDelete: Cascade)

  /// Referencias de Planos de Estudo a este material (Etapa 27) - o material
  /// continua pertencendo a quem/o-que ja pertence acima; isto e so a lista
  /// de planos que o "adicionaram" como leitura de apoio.
  examPrepLinks ExamPrepMaterial[]

  @@index([userId, subjectId])
  @@index([assignmentId])
  @@map("attachments")
}

// =============================================================================
// Anotacoes
// =============================================================================

/// Pasta de anotacoes de uma disciplina. Auto-referenciada para permitir
/// aninhamento livre, como no Explorer/Finder.
model NoteFolder {
  id   String @id @default(cuid())
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  /// Pasta-mae. Nula na raiz da disciplina. Cascade: excluir uma pasta leva
  /// junto as subpastas e notas dentro dela.
  parentId String?
  parent   NoteFolder?  @relation("NoteFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children NoteFolder[] @relation("NoteFolderTree")

  notes Note[]

  @@index([userId, subjectId])
  @@index([parentId])
  @@map("note_folders")
}

/// Nota de texto rico presa a uma disciplina, solta na raiz ou dentro de uma
/// pasta. O conteudo trafega como o documento JSON do editor (Tiptap) - o
/// backend nunca interpreta essa estrutura, so guarda e devolve.
model Note {
  id      String @id @default(cuid())
  title   String
  content Json   @default("{\"type\":\"doc\",\"content\":[]}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  folderId String?
  folder   NoteFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([userId, subjectId])
  @@index([folderId])
  @@map("notes")
}

// =============================================================================
// Cronograma de estudos
// =============================================================================

/// Bloco de estudo agendado. Gerado pelo planejador a partir da disponibilidade
/// do usuario ou criado manualmente.
model StudySession {
  id    String @id @default(cuid())
  title String

  scheduledStart DateTime
  scheduledEnd   DateTime

  /// Minutos efetivamente estudados, preenchido ao concluir a sessao.
  actualMinutes Int?

  status StudySessionStatus @default(PLANNED)
  notes  String?            @db.Text

  /// Marca sessoes criadas pelo gerador automatico, permitindo regerar o
  /// cronograma sem apagar blocos criados a mao.
  autoGenerated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  examId String?
  exam   Exam?   @relation(fields: [examId], references: [id], onDelete: Cascade)

  /// Plano de Estudos (Etapa 27) - SetNull, nao Cascade: a sessao ja soma nas
  /// Estatisticas, e excluir o plano nao pode apagar retroativamente um
  /// minuto ja contado.
  examPrepId String?
  examPrep   ExamPrep? @relation(fields: [examPrepId], references: [id], onDelete: SetNull)

  @@index([userId, scheduledStart])
  @@index([userId, status])
  @@index([examPrepId])
  @@map("study_sessions")
}

// =============================================================================
// Notificacoes
// =============================================================================

model Notification {
  id       String               @id @default(cuid())
  type     NotificationType
  priority NotificationPriority @default(INFO)
  title    String
  message  String               @db.Text

  /// Referencia generica a entidade de origem, evitando uma FK por tipo.
  entityType String?
  entityId   String?

  readAt       DateTime?
  scheduledFor DateTime?

  /// Push ja enviado para esta notificacao (Etapa 28.11). Nulo = ainda nao
  /// despachada. So URGENT/ATTENTION viram push - o disparo so seta isto
  /// para essas, nunca para INFO. Independente de `readAt`: uma notificacao
  /// pode ser lida no sino sem nunca ter sido empurrada, e vice-versa.
  pushedAt DateTime?

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  /// A varredura sob demanda procura por entidade para atualizar em vez de
  /// duplicar a mesma notificacao a cada abertura do sino.
  @@index([userId, entityType, entityId])
  /// O disparo de push varre por isto - so as pendentes de envio.
  @@index([pushedAt])
  @@map("notifications")
}

/// Inscricao de push (Etapa 28.11). Varios registros por usuario - cada
/// navegador/aparelho onde a permissao foi concedida gera um `endpoint`
/// proprio, e nao ha limite de quantos um usuario pode ter simultaneamente.
model PushSubscription {
  id        String  @id @default(cuid())
  /// URL unica do endpoint do provedor push (FCM, Mozilla Push, etc.) -
  /// identifica o par navegador+dispositivo, nao o usuario.
  endpoint  String  @unique
  p256dh    String
  auth      String
  /// So para exibir "qual aparelho" numa tela de gerenciamento futura -
  /// nunca usado para decisao de negocio.
  userAgent String?

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// =============================================================================
// Turmas (Etapa 20)
// =============================================================================
//
// Publicacao + copia (fan-out), nunca linha compartilhada: ver a decisao no
// README ("## Turmas (planejado)"). A turma guarda o registro canonico -
// nome, disciplinas, avisos; cada membro guarda copias pessoais (semestre,
// disciplina, nota) para as quais a turma so aponta.

model Class {
  id   String @id @default(cuid())
  name String
  /// Ano/periodo canonicos da turma. Cada membro traduz isso para O SEU
  /// Semester ao entrar (`ClassMember.semesterId`).
  year Int
  term Int

  description String? @db.Text
  color       String  @default("#4f7cff")

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  ownerId String
  owner   User   @relation("ClassOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members       ClassMember[]
  invites       ClassInvite[]
  subjects      ClassSubject[]
  posts         ClassPost[]
  announcements ClassAnnouncement[]
  notes         ClassNote[]
  materials     ClassMaterial[]

  @@index([ownerId])
  @@map("classes")
}

/// Vinculo de um usuario com uma turma. O dono tambem tem uma linha aqui
/// (role: OWNER) - simplifica toda consulta de "quem esta na turma" para uma
/// unica tabela, em vez de sempre ter que unir com `Class.ownerId` a parte.
model ClassMember {
  id     String            @id @default(cuid())
  role   ClassRole         @default(MEMBER)
  status ClassMemberStatus @default(ACTIVE)

  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// O semestre PESSOAL do membro, correspondente ao ano/periodo da turma.
  /// Criado (ou reaproveitado, se ja existir um com o mesmo ano/periodo) no
  /// momento da entrada - nunca e o mesmo registro entre dois membros.
  semesterId String?
  semester   Semester? @relation(fields: [semesterId], references: [id], onDelete: SetNull)

  subjectLinks ClassSubjectLink[]

  @@unique([classId, userId])
  @@index([userId])
  @@map("class_members")
}

/// Convite de entrada. So o hash e persistido (mesmo padrao de
/// `RefreshToken.tokenHash`) - o valor puro existe apenas na resposta da
/// criacao e no link/QR entregues ao dono.
model ClassInvite {
  id String @id @default(cuid())

  tokenHash String @unique

  /// Ausente = sem expiracao por tempo. Mesma logica para `maxUses`.
  expiresAt DateTime?
  maxUses   Int?
  useCount  Int       @default(0)
  revokedAt DateTime?

  createdAt DateTime @default(now())

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([classId])
  @@map("class_invites")
}

/// Disciplina no nivel da turma - o registro canonico que o dono mantem.
/// Distinta de `Subject`: esta carrega dado privado (notas, configuracao) que
/// nao pode ser compartilhado; `ClassSubject` e so o "molde".
model ClassSubject {
  id   String  @id @default(cuid())
  name String
  code String?

  color       String  @default("#6366f1")
  teacherName String?
  credits     Int?

  /// Ordem de exibicao na aba Disciplinas da turma.
  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  links ClassSubjectLink[]
  posts ClassPost[]

  @@index([classId])
  @@map("class_subjects")
}

/// Liga o molde da turma a disciplina real de um membro. Criado ao entrar
/// (achou disciplina com nome equivalente -> vincula; nao achou -> cria) e
/// reaproveitado se o membro entrar em outra turma com uma materia homonima.
///
/// `subjectId` NAO e unico aqui: a mesma disciplina do usuario pode ser alvo
/// de vinculos de turmas diferentes.
model ClassSubjectLink {
  id String @id @default(cuid())

  createdAt DateTime @default(now())

  classSubjectId String
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  /// Referencia auxiliar ao vinculo de associacao (nao usada em cascata -
  /// sair da turma preserva disciplina e vinculo, ver Etapa 20 no README).
  classMemberId String
  classMember   ClassMember @relation(fields: [classMemberId], references: [id], onDelete: Cascade)

  @@unique([classSubjectId, userId])
  @@index([userId])
  @@index([subjectId])
  @@map("class_subject_links")
}

/// Publicação compartilhada (Etapa 21): o registro canônico que o dono edita.
/// Guarda a união dos campos das três entidades que pode gerar - só os do
/// `kind` escolhido são preenchidos, os demais ficam nulos.
model ClassPost {
  id   String        @id @default(cuid())
  kind ClassPostKind

  title       String
  description String? @db.Text

  // --- Prova (kind: EXAM) ------------------------------------------------------
  date            DateTime?
  durationMinutes Int?
  room            String?

  // --- Atividade (kind: ASSIGNMENT) ---------------------------------------------
  dueDate   DateTime?
  priority  Priority?
  maxPoints Float?

  // --- Evento (kind: EVENT) ------------------------------------------------------
  startsAt DateTime?
  endsAt   DateTime?
  allDay   Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  /// Ausente = publicação avulsa, sem disciplina (só cabe a ASSIGNMENT/EVENT -
  /// EXAM sempre exige uma, porque `Exam.subjectId` não é anulável).
  classSubjectId String?
  classSubject   ClassSubject? @relation(fields: [classSubjectId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  copies ClassPostCopy[]

  /// Selo "Da turma" nas cópias - ver `Assignment.classPostId`.
  assignments    Assignment[]
  exams          Exam[]
  calendarEvents CalendarEvent[]

  @@index([classId])
  @@index([classSubjectId])
  @@map("class_posts")
}

/// Bookkeeping do *fan-out*: qual cópia pessoal pertence a qual membro, e se
/// ele já divergiu dela. O selo "Da turma" em si mora direto na entidade
/// (`Assignment.classPostId` etc.) - este registro só sustenta a propagação.
model ClassPostCopy {
  id String @id @default(cuid())

  /// Não-nulo = o membro editou a cópia; a propagação de edição futura pula
  /// esta linha, mas a exclusão do post ainda a preserva (vira definitivamente
  /// pessoal, perdendo só o selo).
  detachedAt DateTime?

  createdAt DateTime @default(now())

  classPostId String
  classPost   ClassPost @relation(fields: [classPostId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignmentId String?     @unique
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  examId String? @unique
  exam   Exam?   @relation(fields: [examId], references: [id], onDelete: Cascade)

  calendarEventId String?        @unique
  calendarEvent   CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)

  @@unique([classPostId, userId])
  @@map("class_post_copies")
}

/// Aviso do mural da turma (Etapa 22). Texto simples e efêmero, diferente de
/// `ClassNote` - "fixado aparece primeiro" é o único ordenamento que importa.
/// Só o dono publica (ver tabela de papéis no README); o campo `pinned`
/// controla a ordenação, não é um tipo à parte.
model ClassAnnouncement {
  id      String  @id @default(cuid())
  title   String
  content String  @db.Text
  pinned  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([classId, pinned, createdAt])
  @@map("class_announcements")
}

/// Anotação duradoura do mural da turma (Etapa 22). Mesmo formato de `Note`
/// (documento Tiptap/ProseMirror), mas com UM autor só - o dono - nada
/// colaborativo: não há travamento de edição concorrente porque não existe
/// edição concorrente.
model ClassNote {
  id      String @id @default(cuid())
  title   String
  content Json   @default("{\"type\":\"doc\",\"content\":[]}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([classId])
  @@map("class_notes")
}

/// Material da turma (Etapa 23): linha única, sem *fan-out* - duplicar um PDF
/// de 8 MB por membro seria desperdício direto de armazenamento. Reaproveita
/// o `StorageProvider`, a validação por *magic bytes* e o `multer` já usados
/// pelos materiais pessoais (`Attachment`), mas mora em tabela própria: o
/// acervo é contado por TURMA, não por quem enviou (ver `Aceite` no README).
model ClassMaterial {
  id   String         @id @default(cuid())
  name String
  type AttachmentType @default(OTHER)

  /// Caminho de download servido pela API (upload) ou o endereço externo (link).
  url        String  @db.Text
  /// Chave no storage. Nulo quando o material e apenas um link.
  storageKey String?

  mimeType  String?
  sizeBytes Int?

  source AttachmentSource @default(UPLOAD)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  /// Quem publicou - qualquer membro, não só o dono (ver tabela de papéis).
  /// Determina quem pode excluir: o autor, ou o dono, qualquer um.
  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([classId])
  @@map("class_materials")
}

// =============================================================================
// Flashcards
// =============================================================================

/// Baralho de cartoes. Agrupa flashcards por assunto dentro de uma disciplina:
/// "Formulas de derivada" e "Teoremas de convergencia" sao baralhos distintos
/// de Calculo III, e o aluno estuda um por vez.
model Deck {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text

  /// Cor usada nos cards e graficos, no mesmo padrao de Subject.
  color String @default("#6366f1")

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Opcional: um baralho pode ser geral ("Ingles tecnico") ou preso a uma
  /// disciplina. SetNull para que excluir a disciplina nao apague o estudo.
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  /// Plano de Estudos (Etapa 27) - opcional: baralhos existentes continuam
  /// soltos (nunca migrados automaticamente, ver decisao no plano). Um
  /// baralho criado a partir de um plano nasce com este vinculo, e Cascade
  /// porque nesse caso ele e dado exclusivo do plano.
  examPrepId String?
  examPrep   ExamPrep? @relation(fields: [examPrepId], references: [id], onDelete: Cascade)

  cards Flashcard[]

  @@index([userId, subjectId])
  @@index([userId, archivedAt])
  @@index([examPrepId])
  @@map("decks")
}

/// Cartao com pergunta e resposta, mais o estado de repeticao espacada.
///
/// Os campos `easeFactor`, `intervalDays` e `repetitions` implementam o SM-2:
/// guardar o agendamento no proprio cartao evita uma consulta extra para
/// descobrir o que revisar - a pergunta "o que vence hoje" vira um unico
/// `WHERE dueDate <= now()`.
model Flashcard {
  id    String  @id @default(cuid())
  front String  @db.Text
  back  String  @db.Text
  /// Dica opcional, exibida antes de virar o cartao.
  hint  String? @db.Text

  // --- Estado do SM-2 ---------------------------------------------------------
  /// Facilidade do cartao. Comeca em 2.5 e nunca cai abaixo de 1.3, senao um
  /// cartao dificil ficaria preso repetindo todo dia para sempre.
  easeFactor   Float @default(2.5)
  /// Intervalo atual em dias ate a proxima revisao.
  intervalDays Int   @default(0)
  /// Acertos consecutivos. Zera a cada erro.
  repetitions  Int   @default(0)

  /// Quando o cartao deve voltar. Nulo enquanto nunca foi estudado - e esses
  /// entram na fila como novos.
  dueDate        DateTime?
  lastReviewedAt DateTime?

  /// Contadores acumulados, uteis no card do baralho sem varrer o log.
  totalReviews Int @default(0)
  lapses       Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deckId String
  deck   Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)

  reviews FlashcardReview[]

  /// Sustenta a fila de revisao, que e a consulta mais frequente da tela.
  @@index([userId, dueDate])
  @@index([deckId, dueDate])
  @@map("flashcards")
}

/// Registro imutavel de uma revisao.
///
/// O estado no cartao responde "o que revisar agora"; ele nao responde "quanto
/// estudei nesta semana". As Estatisticas precisam da segunda pergunta, e o
/// historico so existe se for gravado no momento em que acontece.
model FlashcardReview {
  id String @id @default(cuid())

  /// Avaliacao do aluno, de 0 (errei) a 5 (facil).
  quality      Int
  /// Intervalo aplicado apos esta revisao, em dias.
  intervalDays Int
  /// Tempo gasto no cartao, quando o cliente conseguir medir.
  durationMs   Int?

  reviewedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  flashcardId String
  flashcard   Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
  @@index([flashcardId])
  @@map("flashcard_reviews")
}

// =============================================================================
// Disponibilidade para estudo
// =============================================================================

/// Janela semanal em que o aluno consegue estudar.
///
/// Tabela propria em vez de um JSON no usuario: um dia costuma ter mais de uma
/// janela ("livre das 9h as 11h e das 14h as 18h"), e o gerador precisa
/// consultar isso por dia da semana. Em JSON toda geracao leria o objeto
/// inteiro e filtraria em memoria.
model StudyAvailability {
  id String @id @default(cuid())

  /// 0 = domingo, 6 = sabado. Mesma convencao de `Date.getDay()`.
  dayOfWeek Int

  /// Minutos desde a meia-noite. Guardar como inteiro evita o problema de
  /// gravar "14:00" num DateTime e depois brigar com fuso horario.
  startMinute Int
  endMinute   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
  @@map("study_availability")
}

// =============================================================================
// Plano de Estudos (Etapa 27)
// =============================================================================
//
// Nome interno "ExamPrep", nao "StudyPlan": esse nome ja pertence ao
// Cronograma (study-plan.routes.ts, study-sessions, StudySession/
// StudyAvailability acima). O rotulo em portugues que o aluno ve continua
// "Plano de Estudos" - mesma separacao entre nome interno e rotulo que o
// projeto ja usa em "Materiais" (Attachment) e "Cronograma" (study-plan).
//
// Ver docs/modules/plano-de-estudos.md para a documentacao completa.

enum ExamPrepItemStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

/// O espaco de preparacao de UM aluno para UMA prova. Reune o que ja existe
/// no sistema (materiais, flashcards, sessoes de estudo) em vez de duplicar.
model ExamPrep {
  id String @id @default(cuid())

  /// Anotacoes da prova, um blob so - mesmo padrao do ClassNote (Mural da
  /// turma), nao do Note/NoteFolder (que existe para organizar muitas notas
  /// de uma disciplina inteira em pastas - excesso para uma prova so).
  notes Json @default("{\"type\":\"doc\",\"content\":[]}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Exam.userId ja torna a prova exclusiva de um aluno (inclusive quando
  /// veio de turma, via fan-out) - @unique aqui ja garante "no maximo um
  /// plano por prova, por aluno" sem precisar compor com userId.
  examId String @unique
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  items         ExamPrepItem[]
  materials     ExamPrepMaterial[]
  decks         Deck[]
  studySessions StudySession[]

  @@index([userId])
  @@map("exam_preps")
}

/// Conteudos do plano - "o que estudar" (checklist simples).
model ExamPrepItem {
  id     String             @id @default(cuid())
  title  String
  status ExamPrepItemStatus @default(NOT_STARTED)
  order  Int                @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  examPrepId String
  examPrep   ExamPrep @relation(fields: [examPrepId], references: [id], onDelete: Cascade)

  @@index([examPrepId])
  @@map("exam_prep_items")
}

/// Referencia a um material JA EXISTENTE (Attachment) - nao duplica o
/// arquivo, nao move o vinculo que ele ja tem (disciplina/atividade/prova/
/// solto). So a linha de juncao some se o plano for excluido.
model ExamPrepMaterial {
  id      String   @id @default(cuid())
  addedAt DateTime @default(now())

  examPrepId String
  examPrep   ExamPrep @relation(fields: [examPrepId], references: [id], onDelete: Cascade)

  attachmentId String
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@unique([examPrepId, attachmentId])
  @@map("exam_prep_materials")
}
