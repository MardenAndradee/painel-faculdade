{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "arrowParens": "always",
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "./apps/web/app/globals.css",
  "overrides": [
    {
      "files": "*.prisma",
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
